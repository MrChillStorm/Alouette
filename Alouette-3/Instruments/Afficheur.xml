	<animation>
		<!-- The needle's angle at each printed value is the dial's own (the numbers .4 to 1 and the ticks). The blade pitch
		     at each value, from the original table's notes (decimal degrees, 1.09 deg for each 0.1 from .7 to 1: 13.15, 14.24,
		     15.33, 16.42 for 1; GP 18.3, PP 5.5), is the pitch at the blade ROOT, the pilot's collective pitch; fcs/x-col is the
		     pitch at 0.7 R, the root's less the twist (4.55 deg), so each input is the dial's pitch less that. The check: the
		     computer's worked example (3700 m density altitude, 1940 kg in the hover, needle at the 93 % limit = 15.66 deg) in
		     this model takes 14.75 deg at the root (10.20 at 0.7 R, which the dial's scale would not reach). The hover at
		     2200 kg, sea level takes 13.17 deg at the root: .70 -->
		<type>rotate</type>
		<object-name>needle-col</object-name>
		<property>fdm/jsbsim/fcs/x-col</property>
		<interpolation>
			<entry>
				<ind>-0.079412481</ind>
				<dep>-5</dep>
			</entry>
			<entry>
				<ind>0.016580628</ind> <!--  PP 10%  5°50 -->
				<dep>22</dep> <!--10% ???-->
			</entry>
			<entry>
				<ind>0.093026049</ind><!--40%: 9.88 deg-->
				<dep>70</dep>
			</entry>
			<entry>
				<ind>0.112050138</ind><!--50%: 10.97 deg-->
				<dep>93</dep>
			</entry>
			<entry>
				<ind>0.131074227</ind><!--60% : 12.06 deg (12°04') -->
				<dep>116</dep>
			</entry>
			<entry>
				<ind>0.150098319</ind><!--70% : 13°15' -->
				<dep>143</dep>
			</entry>
			<entry>
				<ind>0.169122409</ind><!--80% : 14°24'-->
				<dep>172</dep>
			</entry>
			<entry>
				<ind>0.188146489</ind> <!--90% : 15°33' -->
				<dep>201</dep>
			</entry>
			<entry>
				<ind>0.207170579</ind> <!--100% : 16°42' -->
				<dep>234</dep>
			</entry>
			<entry>
				<ind>0.239982769</ind><!--GP 18°30'- -->
				<dep>270</dep> 
			</entry>
		</interpolation>
		<center>
			<x-m>0.0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
		</center>
		<axis>
			<x>-1</x>
			<y>0</y>
			<z>0</z>
			</axis>
	</animation>

	<!-- The computer (Nasal/pitch_computer.nas). The mobile ring, with the outer pitch scale and the temperature scale on it, is
	     turned until the outside temperature meets the pressure altitude on the fixed ring's altitude scale, as the pilot turns
	     it; the reminder triangle is set to the highest pitch for the density altitude, on the needle's scale. -->
	<animation>
		<type>rotate</type>
		<object-name>cercle_mobile</object-name>
		<property>instrumentation/pitch-computer/ring-deg</property>
		<center>
			<x-m>0.0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
		</center>
		<axis>
			<x>-1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>MaxPitch</object-name>
		<property>instrumentation/pitch-computer/max-pitch-deg</property>
		<center>
			<x-m>0.0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
		</center>
		<axis>
			<x>-1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>


