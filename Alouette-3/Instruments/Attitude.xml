<?xml version="1.0"?>

<!--Usable with FlightGear
Original instrument (attitudeV6.ac): property of Gerard Robin, Copyright License: GPLv2.

This version (attitudeV7.ac) is drawn after photographs of the SFENA 42-86 gyro horizon, the instrument the SA 316B
specification lists for IFR flight: a teal sky and a dark ground with white pitch lines across the ball and an orange
horizon, a fixed orange aircraft symbol, the bank scale along the bottom of the dial with a pointer on it. The original's
bracket and the yellow-black horizon bar are left out; the original model is kept as attitudeV6.ac.
-->

  <PropertyList>
    <path>Models/attitudeV7.ac</path>
    <texture-path>Models/Textures</texture-path>

    <!-- the ball and the bank pointer roll with the aircraft -->
    <animation>
      <type>rotate</type>
      <object-name>Ball</object-name>
      <object-name>BankPtr</object-name>
      <property>orientation/roll-deg</property>
      <center>
        <x-m>0</x-m>
        <y-m>0</y-m>
        <z-m>0</z-m>
      </center>
      <axis>
        <x>1</x>
        <y>0</y>
        <z>0</z>
      </axis>
    </animation>

    <!-- the ball (AIBall.png, the horizon in the middle of the texture): the real ball's marks are laid out as on a sphere
         seen from the front, a degree of pitch moving the horizon 0.79 mm of the face (0.003816 of the texture); nose up
         shows more of the sky in the middle of the opening, the horizon going down -->
    <animation>
      <type>textranslate</type>
      <object-name>Ball</object-name>
      <property>orientation/pitch-deg</property>
      <factor>0.003816</factor>
      <axis>
        <x>0</x>
        <y>1</y>
        <z>0</z>
      </axis>
    </animation>

  </PropertyList>
