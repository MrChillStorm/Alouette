  <PropertyList>
    <path>Models/attitudeV6.ac</path>
    <texture-path>Models/Textures</texture-path>


    <animation include="Instrument-Light4.xml">
        <object-name>Mark</object-name>
        <object-name>Horizon</object-name>
        <object-name>Fleche</object-name>
    </animation>

    <animation include="Instrument-Light3.xml">
        <object-name>Cadran</object-name>
        </animation>

    <animation>
      <type>rotate</type>
      <object-name>Fleche</object-name>
      <object-name>Fleche-Fond</object-name>
      <object-name>Horizon</object-name>
      <object-name>Ball</object-name>
      <property>orientation/roll-deg</property>
       <center>
                <x-m>0</x-m>
                <y-m>0</y-m>
                <z-m>0</z-m>
        </center>
      <axis>
        <x>1</x>
        <y>0</y>
        <z>0</z>
      </axis>
    </animation>
    <animation>
      <type>rotate</type>
      <object-name>Horizon</object-name>
      <property>orientation/pitch-deg</property>
      <!-- the horizon bar follows the horizon on the ball (the "Ball" below: 1.1 mm of the ball's face a degree of
           pitch, the bar 0.1128 m from the pivot, so 0.563 deg of its swing a degree), until it reaches the edge of
           the opening at 15 deg of swing, 26.65 deg of pitch -->
      <interpolation>
        <entry>
            <ind>-180</ind>
            <dep>-15</dep>
        </entry>
        <entry>
            <ind>-26.65</ind>
            <dep>-15</dep>
        </entry>
        <entry>
            <ind>0</ind>
            <dep>0</dep>
        </entry>
        <entry>
            <ind>26.65</ind>
            <dep>15</dep>
        </entry>
        <entry>
            <ind>180</ind>
            <dep>15</dep>
        </entry>
      </interpolation>
       <center>
           <x-m>-0.056363</x-m>
            <y-m>0</y-m>
            <z-m>-0.014306</z-m>
        </center>
      <axis>
        <x>0</x>
        <y>1</y>
        <z>0</z>
      </axis>
    </animation>

    <!-- the ball (AIBall.png, generated: the horizon in the middle of the texture, 10 deg of pitch 0.0535 of it): nose up shows
         more of the sky in the middle of the opening, the horizon going down; it rolls with the animation above -->
    <animation>
      <type>textranslate</type>
      <object-name>Ball</object-name>
      <property>orientation/pitch-deg</property>
      <factor>0.005352</factor>
      <axis>
        <x>0</x>
        <y>1</y>
        <z>0</z>
      </axis>
    </animation>

  </PropertyList>
