 <!-- Co-pilot -->


 <controls>
	<engines>
                <!-- the collective: the throttle axis, not inverted by default (full throttle the lever at the top; invert-collective below flips it); the
                     flight model keeps the throttle in step with the collective (/controls/al3/collective) -->
                <engine n="0">
                        <throttle>1</throttle>
                </engine>
	</engines>
	<al3>
		<!-- 1: the collective is 1 - throttle (Configuration dialog: Invert collective axis) -->
		<invert-collective type="bool">false</invert-collective>
		<!-- the tail rotor control's hydraulic damper, as the time constant in seconds of a lag between pedals and tail rotor
		     (Configuration dialog's slider); 0: none -->
		<rudder-damper type="double">0</rudder-damper>
		<!-- a gain on their level (Configuration dialog's slider): the HDR renderer's exposure is no real eye's, so it starts at 2 -->
		<instrument-light-gain type="double">2</instrument-light-gain>
		<collective type="double">0</collective>
	</al3>
        <gear>
	    <brake-parking type="bool">true</brake-parking>
               <!-- <brake-parking alias="/fdm/jsbsim/fcs/brake-parking-cmd-norm"/>-->
		<!--<brake-left alias="/fdm/jsbsim/fcs/left-brake-cmd-norm"/>
		<brake-right alias="/fdm/jsbsim/fcs/right-brake-cmd-norm"/>-->
        </gear>
 </controls>

