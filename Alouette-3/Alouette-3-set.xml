<PropertyList>
    <note>
        This model was created using publicly available data, publicly available
        technical reports, textbooks, and guesses. It contains no proprietary or
        restricted data. It has been validated only to the extent that it seems
        to "fly right", and possibly to comply to published, publicly known,
        performance data (maximum speed, endurance, etc.). Thus, this model
        is meant for educational and entertainment purposes only.

        This simulation model is not endorsed by the manufacturer.
    </note>


 <sim>
	<description>Sud Aviation SA 316B Alouette III (JSBSim)</description>
        <author>Gerard Robin, David, Josh, Thorsten Renk, Colin Geniet (3d, systems, Nasal); JSBSim FDM generated by fdm/genal3.py</author>
        <status>beta</status>
        <version>2026-11</version>
        <minimum-fg-version>2024.2.0</minimum-fg-version>
        <tags>
          <tag>HDR</tag>
          <tag>helicopter</tag>
          <tag>tricycle</tag>
          <tag>fixed-gear</tag>
          <tag>single-engine</tag>
          <tag>turboprop</tag>
	  <tag>vtol</tag>
          <tag>1960s</tag>
          <tag>1970s</tag>
          <tag>1980s</tag>
        </tags>
	<rating>
	 <!--only  a generic wrong estimation since given by the author himself-->   
	    <FDM type="int">3</FDM>
	    <systems type="int">3</systems>
	    <model type="int">3</model>
	    <cockpit type="int">3</cockpit>
	</rating>
	<flight-model>jsb</flight-model>
	<!-- the generated flight model (fdm/genal3.py): alouette3.xml and Systems/al3-*.xml; the original JSBSim model is
	     kept in Aero/al3-jsbsim.xml -->
	<aero>alouette3</aero>
	<!-- the model's rate: the blades' flap and lag and the tail rotor's flapping, 12.5 deg of its azimuth a step -->
	<model-hz type="int">480</model-hz>
        <startup>
	<splash-texture>Aircraft/Alouette-3/Pics/alouette3-exterior03.jpg</splash-texture>
        </startup>
        <checklists include="Alouette-III-checklists.xml"/>
	<previews>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Pics/alouette3-exterior01.jpg</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Pics/alouette3-exterior02.jpg</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Pics/alouette3-exterior03.jpg</path>
	  </preview>
	  <preview>
		<type>panel</type>
		<splash type="bool">true</splash>
		<path>Pics/alouette3-interior.jpg</path>
	  </preview>
	</previews>

	<sound>
	    <path>Aircraft/Alouette-3/Sounds/al3-sound.xml</path>
	</sound>

        <instrumentation>
            <path>Aircraft/Alouette-3/Instruments/instrumentation.xml</path>
        </instrumentation>

        <hud>
           <!-- <path n="1">Huds/default.xml</path>-->
            <visibility n="1">false</visibility>
            <enable3d n="1">false</enable3d>
        </hud>

        <systems>
            <electrical>
                <path>Aircraft/Alouette-3/Systems/dummy-electrical.xml</path>
            </electrical>
            <!-- the test autopilot (fdm/genap.py) that flies the report's test flights offline: hover, cruise and
                 autorotation holds, set through /autopilot/al3 (not on the cockpit's controls) -->
            <autopilot n="10">
                <name>Alouette III test autopilot</name>
                <path>Aircraft/Alouette-3/Systems/al3-autopilot.xml</path>
            </autopilot>
        </systems>

        <model>
		<!--dont load Carrier System-->
		<carrier-jsbsim type="bool">false</carrier-jsbsim>
		<sea-variant  type="bool">false</sea-variant>
                <path archive="y">Aircraft/Alouette-3/Models/Alouette-III-sc_jsb.xml</path>
                <fg-ver_min type="string">2.12</fg-ver_min>
                <fg-ver_max type="string">3.00</fg-ver_max>
                <al3>
                        <instrument-lights type="float">0.7</instrument-lights>
			<panel-lights type="float">0.7</panel-lights>
                        <nav-lights type="float">1</nav-lights>
                </al3>
		<ski-equipment type="bool">false</ski-equipment>
                <rescue-lift>1</rescue-lift>
                <rescue type="bool">false</rescue>
                <rescue-flex type="bool">false</rescue-flex>
                <rescue-none type="bool">true</rescue-none>
                <shader>
                    <reflection-correction type="float">0.2</reflection-correction>
		    <reflection-enabled type="int">1</reflection-enabled>
		    <reflection-fresnel type="float">0.05</reflection-fresnel>
		    <reflection-noise type="float">0.3</reflection-noise>
		    <ambient-correction type="float">0.0</ambient-correction>
		    <reflection-rainbow type="float">0.05</reflection-rainbow>
		</shader>
		<shader_2>
		    <reflection-correction type="float">0.4</reflection-correction>
		    <reflection-enabled type="int">1</reflection-enabled>
		    <reflection-fresnel type="float">0.2</reflection-fresnel>
		    <reflection-noise type="float">0.4</reflection-noise>
		    <ambient-correction type="float">0.0</ambient-correction>
		    <reflection-rainbow type="float">0.1</reflection-rainbow>
		</shader_2>
        	<crew include="Models/Crew/crew_cfg.xml"/>
        </model>
        <winch include="Models/Rope/rope_definitions.xml"/>
        <view>
                <internal archive="y">true</internal>
                <config>
                            <x-offset-m archive="y">0.556831</x-offset-m><!--right-->
                            <y-offset-m archive="y">0.59</y-offset-m><!--up-->
                            <z-offset-m archive="y">-1.45</z-offset-m><!--back-->
                            <heading-offset-deg>0</heading-offset-deg>
                            <pitch-offset-deg>-14</pitch-offset-deg>
                            <default-field-of-view-deg type="double">75.0</default-field-of-view-deg>
                </config>
        </view>
        <view n="100">
            <name>Rescued_View</name>
            <type>lookfrom</type>
            <internal >false</internal>
            <config>
                <from-model type="bool">true</from-model>
                <ground-level-nearplane-m type="double">0.05f</ground-level-nearplane-m>
                <x-offset-m >-4.00</x-offset-m>
                <y-offset-m >-0</y-offset-m>
                <z-offset-m >10</z-offset-m>
                <pitch-offset-deg>0</pitch-offset-deg>
                <default-field-of-view-deg>75</default-field-of-view-deg>
            </config>
            </view>
            <view n="101">
                <name>Wide-cockpit_View</name>
                <type>lookfrom</type>
                <internal >false</internal>
                <config>
                    <from-model type="bool">true</from-model>
                    <x-offset-m archive="y">0.556831</x-offset-m><!--right-->
                    <y-offset-m archive="y">0.59</y-offset-m><!--up-->
                    <z-offset-m archive="y">-1.45</z-offset-m><!--back-->
                    <heading-offset-deg>3</heading-offset-deg>
                    <pitch-offset-deg>-19</pitch-offset-deg>
                    <default-field-of-view-deg type="double">80.0</default-field-of-view-deg>
                </config>
        </view>
	<view n="102">
                <name>Close_To_Panel_View</name>
                <type>lookfrom</type>
                <internal >false</internal>
                <config>
                    <from-model type="bool">true</from-model>
                    <x-offset-m archive="y">0.556831</x-offset-m><!--right-->
                    <y-offset-m archive="y">0.59</y-offset-m><!--up-->
                    <z-offset-m archive="y">-1.45</z-offset-m><!--back-->
                    <heading-offset-deg>13</heading-offset-deg>
                    <pitch-offset-deg>-28</pitch-offset-deg>
                    <default-field-of-view-deg type="double">54.0</default-field-of-view-deg>
                </config>
        </view>
        <chase-distance-m type="double">-15.0</chase-distance-m>


        <help include="Help/Alouette-III-help_dev.xml"/>
        <menubar  include="Inputs/Alouette-III-menu2.xml"/>
	<multiplay include="Outputs/Alouette-III-multiplay.xml"/>
 </sim>

 <autopilot>
    <al3 include="Systems/al3-autopilot-props.xml"/>
 </autopilot>


 <!-- Co-pilot -->


 <controls>
	<engines>
                <!-- the collective: the throttle axis, inverted by default (full throttle the lever at the bottom); the
                     flight model keeps the throttle in step with the collective (/controls/al3/collective) -->
                <engine n="0">
                        <throttle>1</throttle>
                </engine>
	</engines>
	<al3>
		<!-- 1: the collective is 1 - throttle (Configuration dialog: Invert collective axis) -->
		<invert-collective type="bool">true</invert-collective>
		<collective type="double">0</collective>
	</al3>
        <gear>
	    <brake-parking type="bool">true</brake-parking>
               <!-- <brake-parking alias="/fdm/jsbsim/fcs/brake-parking-cmd-norm"/>-->
		<!--<brake-left alias="/fdm/jsbsim/fcs/left-brake-cmd-norm"/>
		<brake-right alias="/fdm/jsbsim/fcs/right-brake-cmd-norm"/>-->
        </gear>
 </controls>

 <consumables>
     <fuel>
         <!-- the cubic tank: 565 l, 555 l usable [EASA TCDS R.123]; the flight model (fdm/genal3.py) burns it and carries
              its mass; 60 % full at the start (333 l, 266 kg) -->
         <tank n="0">
             <name>Main</name>
             <capacity-gal_us type="double">146.6</capacity-gal_us>
             <level-lbs type="double">587.4</level-lbs>
             <selected type="bool" write="n">1</selected>
             <density-ppg type="double" write="n">6.676</density-ppg>
         </tank>
     </fuel>
 </consumables>

 <engines>
     <engine n="0">
         <running type="bool">false</running>
     </engine>
     <engine n="1">
         <running type="bool">false</running>
     </engine>
 </engines>

 <instrumentation>
     <gsdi>
         <serviceable type="bool">true</serviceable>
         <enabled type="bool">true</enabled>
     </gsdi>
     <heading-indicator>
	 <indicated-heading-deg type="double">0.0</indicated-heading-deg>
     </heading-indicator>
     <altimeter>
	 <indicated-altitude-ft type="double">0.0</indicated-altitude-ft>
     </altimeter>
</instrumentation>

<!--<input include="Inputs/Alouette-III-input_dev.xml"/>-->
<input include="Inputs/key_bindings.xml"/>

<environment>
    <params>
	<control-fdm-atmosphere type="bool">true</control-fdm-atmosphere>
    </params>
</environment>

<nasal>
    <al3>
        <file>Aircraft/Alouette-3/Nasal/init_Run.nas</file>
        <file>Aircraft/Alouette-3/Nasal/effect_manager.nas</file>
        <file>Aircraft/Alouette-3/Nasal/airstart.nas</file>
    </al3>
    <terrain>
        <file>Aircraft/Alouette-3/Nasal/terrain.nas</file>
    </terrain>
    <crew>
 	<file>Aircraft/Alouette-3/Nasal/crew.nas</file>
    </crew>
    <hdr>
        <file>Aircraft/Alouette-3/Nasal/hdr.nas</file>
    </hdr>
    <rescue>
        <file>Aircraft/Alouette-3/Nasal/rescue_operation.nas</file>
        <file>Aircraft/Alouette-3/Nasal/ropeanimation.nas</file>
    </rescue>
    <!--<nav>
            <file>Aircraft/Alouette-3/Nasal/nav.nas</file>
    </nav>-->
</nasal>

<fdm include="Systems/jsbsim_init.xml"/>



</PropertyList>
