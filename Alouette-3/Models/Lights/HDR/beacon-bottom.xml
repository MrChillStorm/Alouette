<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- beacon-bottom, written by fdm/hdrmodel.py (see there): the X-57 model's halo and, in
     the HDR pipeline, a spot light out through the lens -->

<PropertyList>

  <path>RedLight.ac</path>
  <nopreview/>

  <animation>
    <type>noshadow</type>
    <object-name>Light</object-name>
  </animation>

  <effect>      <!-- its glow: 50 cd over the halo at 1500 m -->
    <inherits-from>Effects/model-pbr-transparent</inherits-from>
    <parameters>
      <metallic-factor type="float">0</metallic-factor>
      <roughness-factor type="float">1</roughness-factor>
      <texture n="3">
        <image>lights.png</image>
        <type>2d</type>
        <filter>linear-mipmap-linear</filter>
        <wrap-s>clamp</wrap-s>
        <wrap-t>clamp</wrap-t>
      </texture>
      <emissive-factor type="vec3d">0.4918 0.02951 0.01475</emissive-factor>
    </parameters>
    <object-name>Light</object-name>
  </effect>

  <animation>
    <type>alpha-test</type>
    <alpha-factor>0.01</alpha-factor>
  </animation>

  <animation>
    <type>billboard</type>
    <object-name>Light</object-name>
    <spherical type="bool">true</spherical>
  </animation>

  <animation>
    <type>material</type>
    <object-name>Light</object-name>
    <emission>
      <red> 2 </red>
      <green> 0 </green>
      <blue> 0 </blue>
    </emission>
  </animation>

  <animation>
    <type>dist-scale</type>
    <object-name>Light</object-name>
    <interpolation>
      <entry><ind> 0 </ind><dep> 0.15 </dep></entry>
      <entry><ind> 20 </ind><dep> 0.35 </dep></entry>
      <entry><ind> 1500 </ind><dep> 4 </dep></entry>
    </interpolation>
  </animation>

  <animation>
    <type>select</type>
    <object-name>Light</object-name>
    <condition>
      <and>
<and>
<not>
<property>fdm/jsbsim/systems/effets/lights/beacon2-on</property>
</not>
<property>fdm/jsbsim/electrical/beacon</property>
</and>
      </and>
    </condition>
  </animation>

  <light>
    <name>beacon-bottom-light</name>
    <type>spot</type>
    <position>
      <x-m> -0 </x-m>
      <y-m> -0 </y-m>
      <z-m> 0.028 </z-m>
    </position>
    <direction>
      <lookat-x-m> 0 </lookat-x-m>
      <lookat-y-m> 0 </lookat-y-m>
      <lookat-z-m> -0.972 </lookat-z-m>
    </direction>
    <color>
      <r> 1 </r>
      <g> 0.06 </g>
      <b> 0.03 </b>
    </color>
    <intensity> 0.07874 </intensity>      <!-- 50 cd -->
    <spot-exponent> -1 </spot-exponent>
    <spot-cutoff> 80 </spot-cutoff>
    <range-m> 30 </range-m>
  </light>

  <animation>
    <type>noshadow</type>
    <object-name>beacon-bottom-light</object-name>
  </animation>

  <animation>
    <type>select</type>
    <object-name>beacon-bottom-light</object-name>
    <condition>
      <and>
        <property>/sim/rendering/hdr/hdr-enabled</property>
<and>
<not>
<property>fdm/jsbsim/systems/effets/lights/beacon2-on</property>
</not>
<property>fdm/jsbsim/electrical/beacon</property>
</and>
      </and>
    </condition>
  </animation>

</PropertyList>
